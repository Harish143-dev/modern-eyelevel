<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Legacy industry URLs -> current /industries/* routes.
  RewriteRule ^real-estate-marketing-agency/?$ /industries/real-estate [R=301,L]
  RewriteRule ^it-saas-marketing-agency/?$ /industries/it-saas [R=301,L]
  RewriteRule ^healthcare-marketing-agency/?$ /industries/healthcare [R=301,L]
  RewriteRule ^automotive-marketing-agency/?$ /industries/automotive [R=301,L]
  RewriteRule ^manufacturing-b2b-marketing-agency/?$ /industries/manufacturing-b2b [R=301,L]
  RewriteRule ^b2b-marketing-agency/?$ /industries/manufacturing-b2b [R=301,L]

  # Legacy URLs with no current equivalent -> industries hub.
  RewriteRule ^(education|sports|pickleball|fintech)-marketing-agency/?$ /industries [R=301,L]
  RewriteRule ^education-digital-marketing-services/?$ /industries [R=301,L]
  RewriteRule ^pickleball-agency/?$ /industries [R=301,L]

  # Block junk query strings like ?161df1950567902.html (not real pages)
  RewriteCond %{QUERY_STRING} ^[0-9a-f]{8,}\.html=?$ [NC]
  RewriteRule ^ - [R=410,L]

  # Optionally block query strings containing ".html" with no key=value params
  RewriteCond %{QUERY_STRING} \.html [NC]
  RewriteCond %{QUERY_STRING} ![=&] [NC]
  RewriteRule ^ - [R=410,L]

  # Server-side redirects (avoid client-only SPA redirects)
  RewriteRule ^how-we-work/?$ /about [R=301,L]
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^works?/?$ /portfolio [R=301,L]
  RewriteRule ^terms-and-conditions/?$ /terms-and-condition [R=301,L]
  RewriteRule ^terms-conditions/?$ /terms-and-condition [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Return a real 404 for unknown routes instead of serving the SPA shell for
  # everything (which would make every typo a soft 404 with a 200 status).
  # This list MUST mirror src/AppRoutes.tsx — update both together when adding
  # a page, or the new route will 404 in production while working in dev.
  RewriteCond %{REQUEST_URI} !^/(?:$|about/?$|portfolio/?$|contact/?$|booking/?$|apply/?$|thank-you/?$|3-websites-free/?$|free-wedding-film/?$|privacy-policy/?$|terms-and-condition/?$|services/?$|services/[^/]+/?$|industries/?$|industries/[^/]+/?$|careers/?$|careers/[^/]+/?$|blog/?$|blog/category/[^/]+/?$|blog/[^/]+/?$) [NC]
  RewriteRule ^ - [R=404,L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML should refresh quickly so users get the latest deployment.
  ExpiresByType text/html "access plus 0 seconds"

  # Static assets can be cached aggressively (hashed filenames in /assets).
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Ensure HTML is revalidated quickly.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache compiled/static files strongly.
  <FilesMatch "\.(?:css|js|mjs|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
